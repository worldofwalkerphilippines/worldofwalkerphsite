<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>World Of Walker PH | Login</title>
    <style>
:root {
    --neon-cyan: #00f2ff;
    --dark-bg: #0a0a0a;
    --glass-bg: rgba(255, 255, 255, 0.05);
}

body {
    margin: 0;
    padding: 0;
    background-color: var(--dark-bg);
    /* Subtle grid pattern background */
    background-image: linear-gradient(rgba(0, 242, 255, 0.05) 1px, transparent 1px),
                      linear-gradient(90deg, rgba(0, 242, 255, 0.05) 1px, transparent 1px);
    background-size: 30px 30px;
    font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
    color: white;
}

.login-container {
    background: var(--glass-bg);
    padding: 40px;
    border-radius: 2px;
    
    border: 1px solid rgba(0, 242, 255, 0.2);
    box-shadow: 0 0 20px rgba(0, 0, 0, 0.5);
    width: 350px;
    text-align: center;
    backdrop-filter: blur(10px);
}

.aw-logo {
    font-size: 3rem;
    font-weight: 800;
    letter-spacing: -5px;
    margin-bottom: 10px;
    color: var(--neon-cyan);
    text-shadow: 0 0 10px var(--neon-cyan);
}

h1 {
    font-size: 0.9rem;
    letter-spacing: 4px;
    margin-bottom: 30px;
    opacity: 0.8;
}

/* Animated Input Fields */
.input-group {
    position: relative;
    margin-bottom: 30px;
}

.input-group input {
    width: 100%;
    background: transparent;
    border: none;
    border-bottom: 1px solid #444;
    padding: 10px 0;
    color: white;
    outline: none;
    transition: 0.3s;
}

.input-group label {
    position: absolute;
    left: 0;
    top: 10px;
    color: #888;
    pointer-events: none;
    transition: 0.3s;
    text-transform: uppercase;
    font-size: 0.75rem;
}

.input-group input:focus ~ label,
.input-group input:valid ~ label {
    top: -15px;
    font-size: 0.7rem;
    color: var(--neon-cyan);
}

.input-group input:focus {
    border-bottom: 1px solid var(--neon-cyan);
}

/* Neon Button */
.glow-btn {
    width: 100%;
    padding: 12px;
    background: transparent;
    border: 1px solid var(--neon-cyan);
    color: var(--neon-cyan);
    cursor: pointer;
    font-weight: bold;
    letter-spacing: 2px;
    transition: 0.4s;
    margin-top: 10px;
}

.glow-btn:hover {
    background: var(--neon-cyan);
    color: black;
    box-shadow: 0 0 15px var(--neon-cyan), 0 0 40px var(--neon-cyan);
}

.footer-links {
    margin-top: 25px;
    display: flex;
    justify-content: space-between;
}

.footer-links a {
    font-size: 0.7rem;
    color: #666;
    text-decoration: none;
    transition: 0.3s;
}

.footer-links a:hover {
    color: var(--neon-cyan);
}
    </style>
</head>
<body>
    <div class="login-container">
        <div class="logo-area">
            <div class="aw-logo"><img src="awlogo.png" alt="World Of Walker"style="width:301px;height:83px;"></img></div>
            <h1>RESTRICTED ACCESS</h1>
            <p>Enter your credentials, Walker.</p>
        </div>        
        <form>
            <div class="input-group">
                <input type="text" required>
                <label>Walker ID / Email</label>
            </div>
            <div class="input-group">
                <input type="password" required>
                <label>Password</label>
            </div>
            <button type="submit" class="glow-btn">INITIALIZE</button>
        </form>
        
        <div class="footer-links">
            <a href="#">Forgot Account?</a>
            <a href="create account.html">Create Account</a>
        </div>
    </div>
</body>
</html>
